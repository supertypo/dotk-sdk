{
  "name": "@dotk/sdk",
  "version": "2.0.0",
  "description": "Read-only client for the dotk name registry on Kaspa: resolve, reverse-look-up, price and verify .k names",
  "license": "MIT",
  "author": "s@dotk.name",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supertypo/dotk-sdk.git"
  },
  "homepage": "https://dotk.name",
  "bugs": "https://github.com/supertypo/dotk-sdk/issues",
  "keywords": [
    "kaspa",
    "dotk",
    "name-service",
    "naming",
    "covenant",
    "wallet",
    "web3"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --build tsconfig.build.json",
    "prepack": "node tools/check-release.mjs && npm run build",
    "prepublishOnly": "node tools/check-release.mjs --strict",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
